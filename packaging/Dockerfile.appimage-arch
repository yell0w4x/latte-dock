# Builds the AppImage on arch, the variant that carries a plasma new enough for Latte Tasks.
#
#   podman build -f packaging/Dockerfile.appimage-arch -t latte-dock:appimage-arch .
#   podman build -f packaging/Dockerfile.appimage-arch --target artifact -o type=local,dest=./out .
#
# The other variant, packaging/Dockerfile.appimage-ubuntu, runs on older hosts and can not
# bring up Latte Tasks; the two are described next to each other in packaging/README.md.
#
# docker understands the same file. The context is the repository root, so both commands are
# run from there.
#
# The result is a single executable Latte_Dock-<version>-arch-x86_64.AppImage carrying Latte with
# the Qt, KDE frameworks and plasma libraries it links, the qml modules its shipped qml
# imports, the plasma plugins and package files it reads and the plasma applets its layouts
# are built from.
#
# What it can not carry is the session it docks into: Latte talks to kwin, plasmashell and
# the activity manager of the machine it runs on, so the AppImage needs a Plasma 6 session
# around it. It exists for running this build on a distribution whose packages are older than
# it, not for running Latte without Plasma.
#
# The base is arch, because Latte Tasks builds on the task manager applet, which plasma
# publishes as a compiled applet plugin ("plasma/applets/org.kde.plasma.taskmanager.so") only
# since Plasma 6.5. Arch is rolling and carries it; debian and ubuntu are still on 6.4, where
# that plugin does not exist and Latte Tasks can not be brought up at all.
#
# The price of a rolling base is the glibc of the host: it has to be at least the one arch
# had when the AppImage was built. A host new enough to run Plasma 6.5 generally is.

ARG BASE_IMAGE=docker.io/library/archlinux:base-devel

FROM --platform=linux/amd64 ${BASE_IMAGE} AS builder

ARG BUILD_TYPE=Release
ARG JOBS=

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The toolchain and dependencies of the arch package, plus what the bundling needs: curl and
# patchelf for the linuxdeploy tools, and the runtime packages whose plugins, qml modules and
# package files are copied into the AppImage rather than only linked against. plasma-desktop
# is there for the task manager applet the tasks plasmoid is built on, plasma-pa for the qml
# the audio badges of a task read the volume through.
RUN pacman -Syu --noconfirm --needed \
        base-devel \
        cmake \
        ninja \
        git \
        curl \
        file \
        patchelf \
        desktop-file-utils \
        dbus \
        extra-cmake-modules \
        gtest \
        qt6-base \
        qt6-declarative \
        qt6-tools \
        qt6-wayland \
        karchive \
        kcoreaddons \
        kcrash \
        kdbusaddons \
        kdeclarative \
        kglobalaccel \
        kguiaddons \
        ki18n \
        kiconthemes \
        kio \
        kirigami \
        knewstuff \
        knotifications \
        kpackage \
        ksvg \
        kwindowsystem \
        kxmlgui \
        kconfig \
        libplasma \
        plasma-activities \
        plasma-workspace \
        plasma-desktop \
        plasma5support \
        plasma-pa \
        kpipewire \
        breeze \
        breeze-icons \
        kwayland \
        plasma-wayland-protocols \
        wayland \
        libsm \
        libxcb \
        xcb-util \
 && pacman -Scc --noconfirm

WORKDIR /src

COPY . /src

RUN cmake -S /src -B /src/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SUPPRESS_REGENERATION=ON \
        -DBUILD_TESTING=ON

RUN cmake --build /src/build ${JOBS:+--parallel ${JOBS}}

# Installing into the system as well as into the AppDir: the tests below compile the shipped
# qml against the installed modules and validate the installed metadata, the qml modules of
# Latte are picked up from the system by the qt plugin of linuxdeploy, and the AppDir is what
# the AppImage is made of.
RUN cmake --install /src/build \
 && DESTDIR=/AppDir cmake --install /src/build

ENV QT_QPA_PLATFORM=offscreen \
    HOME=/tmp/latte-build-home
RUN mkdir -p "${HOME}" \
 && dbus-run-session -- ctest --test-dir /src/build --output-on-failure

# The plugins, qml modules and package files Latte reaches for at runtime. Nothing links
# against these, so no tool can find them by walking the libraries, and the dock comes up
# empty without them.
#
# The plugins go where usr/bin/qt.conf points Qt at, "usr/plugins", and not into the qt
# directory they are installed in; the second one is searched by nothing inside an AppImage.
# The plasma one carries the applets, among them the task manager applet Latte Tasks needs,
# kpackage the structures that make a plasma package readable at all.
RUN set -eu \
 && qtdir="/usr/lib/qt6" \
 && mkdir -p "/AppDir/usr/plugins" "/AppDir/usr/qml" "/AppDir/usr/share" \
 && for plugins in plasma kpackage kf6 kcms styles platformthemes ; do \
        if [ -d "${qtdir}/plugins/${plugins}" ]; then \
            cp -a "${qtdir}/plugins/${plugins}" "/AppDir/usr/plugins/" ; \
        fi ; \
    done \
 && for module in \
        org/kde/latte \
        org/kde/plasma \
        org/kde/kirigami \
        org/kde/ksvg \
        org/kde/taskmanager \
        org/kde/pipewire \
        org/kde/activities \
        org/kde/kwindowsystem \
        org/kde/kquickcontrolsaddons \
        org/kde/config \
        org/kde/kcmutils \
        org/kde/kitemmodels \
        org/kde/coreaddons \
        org/kde/draganddrop \
        org/kde/notification \
        Qt5Compat/GraphicalEffects ; do \
        if [ -d "${qtdir}/qml/${module}" ]; then \
            mkdir -p "/AppDir/usr/qml/$(dirname ${module})" ; \
            cp -a "${qtdir}/qml/${module}" "/AppDir/usr/qml/$(dirname ${module})/" ; \
        fi ; \
    done \
 && for data in plasma kservicetypes6 kf6 knotifications6 ; do \
        if [ -d "/usr/share/${data}" ]; then \
            cp -a "/usr/share/${data}" "/AppDir/usr/share/" ; \
        fi ; \
    done \
 && test -d "/AppDir/usr/plugins/kpackage/packagestructure" \
 && test -d "/AppDir/usr/share/plasma/plasmoids/org.kde.latte.containment" \
 && test -f "/AppDir/usr/plugins/plasma/applets/org.kde.plasma.taskmanager.so"

# linuxdeploy walks the binary and everything it loads and pulls the libraries in; its qt
# plugin does the same for the qt plugins and the qml modules named below. Both are AppImages
# themselves, and the extract and run mode is what lets them run in a container, which has no
# fuse.
#! NO_APPSTREAM keeps appimagetool from validating the metadata a second time. It refuses
#! any warning at all, and the one it finds is cid-rdns-contains-hyphen: the component id of
#! Latte is org.kde.latte-dock.desktop and the hyphen in it is how Latte is published. The
#! test suite validates that same metadata a few steps above and accepts only that warning,
#! see cmake/LatteAppstreamTest.cmake.
#! NO_STRIP keeps linuxdeploy from stripping what it copies. The strip it carries is older
#! than the libraries of a rolling distribution and gives up on the relocation section they
#! are built with; the packages of arch arrive stripped anyway, so nothing is lost.
#! The qt plugin deploys the xcb platform on its own. Latte also runs on wayland sessions,
#! which needs the wayland platform plugin and the client plugins next to it, and the
#! offscreen one is what lets the checks at the end start the bundled binary without a
#! display of any kind.
ENV APPIMAGE_EXTRACT_AND_RUN=1 \
    NO_APPSTREAM=1 \
    NO_STRIP=1 \
    DISABLE_COPYRIGHT_FILES_DEPLOYMENT=1 \
    QMAKE=/usr/lib/qt6/bin/qmake6 \
    EXTRA_PLATFORM_PLUGINS="libqwayland.so;libqoffscreen.so;libqminimal.so" \
    EXTRA_PLUGINS="wayland-shell-integration;wayland-decoration-client;wayland-graphics-integration-client" \
    QML_SOURCES_PATHS=/src

RUN set -eu \
 && cd /tmp \
 && curl -sSfLO https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
 && curl -sSfLO https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
 && chmod +x linuxdeploy-x86_64.AppImage linuxdeploy-plugin-qt-x86_64.AppImage

# The desktop file Latte installs starts the binary by its full path, which inside an
# AppImage points at whatever the host has rather than at what is bundled. The copy in the
# AppDir names it plainly, so the one next to it is the one that runs.
RUN sed -i 's|^Exec=.*|Exec=latte-dock|' \
        /AppDir/usr/share/applications/org.kde.latte-dock.desktop

# The version reaches the file name of the AppImage through this, the way linuxdeploy expects
# it to be given.
#! --deploy-deps-only names the directories that were filled in above: the libraries those
#! plugins and qml plugins need are pulled in and their rpath is rewritten to the bundled
#! ones, which is what linuxdeploy does on its own only for what it copied itself.
#! --custom-apprun replaces the symlink linuxdeploy would leave behind with the script that
#! points XDG_DATA_DIRS at the plasma package files of the bundle, see packaging/AppRun.
RUN set -eu \
 && export VERSION="$(sed -n 's/^set(VERSION *\([^)]*\))/\1/p' /src/CMakeLists.txt | head -1)" \
 && mkdir -p /out \
 && cd /out \
 && /tmp/linuxdeploy-x86_64.AppImage \
        --appdir /AppDir \
        --executable /AppDir/usr/bin/latte-dock \
        --custom-apprun=/src/packaging/AppRun \
        --deploy-deps-only=/AppDir/usr/plugins \
        --deploy-deps-only=/AppDir/usr/qml \
        --plugin qt \
        --desktop-file /AppDir/usr/share/applications/org.kde.latte-dock.desktop \
        --icon-file /AppDir/usr/share/icons/hicolor/scalable/apps/latte-dock.svg \
        --output appimage \
 && mv /out/Latte_Dock-"${VERSION}"-x86_64.AppImage "/out/Latte_Dock-${VERSION}-arch-x86_64.AppImage" \
 && chmod +x /out/*.AppImage \
 && ls -lh /out

# Unpacking it again and starting what it carries, so an AppImage that can not run at all
# fails the build here.
#
# The first check is that it starts, finds its libraries and answers for its version. The
# second one starts it the way a session would, with a home of its own so that it imports the
# default layout, and reads what it says about itself. Two failures hide there, and an
# AppImage with either still starts and shows an empty dock:
#
# without the plasma package files, the corona finds no shell package and says so, and
# without the task manager applet plugin the tasks of the dock stay away and it says that too.
#
# Latte has no session to dock into here, so it is left running for a while and then stopped.
RUN set -eu \
 && cd /tmp \
 && /out/*.AppImage --appimage-extract > /dev/null \
 && ./squashfs-root/AppRun --version \
 && grep -q XDG_DATA_DIRS ./squashfs-root/AppRun \
 && export HOME=/tmp/latte-appimage-home \
 && mkdir -p "${HOME}" \
 && dbus-run-session -- timeout 40 ./squashfs-root/AppRun --debug > /tmp/appimage-check.log 2>&1 || true \
 && ! grep -q "Failed to load fallback plasma shell package" /tmp/appimage-check.log \
 && ! grep -q "the package QJsonObject() is invalid" /tmp/appimage-check.log \
 && grep -q "Task manager applet qml types registered" /tmp/appimage-check.log \
 && ! grep -q "Latte Tasks will not be available" /tmp/appimage-check.log \
 && ! grep -q "is not installed" /tmp/appimage-check.log \
 && ! grep -q "error when loading applet" /tmp/appimage-check.log \
 && rm -rf /tmp/squashfs-root

# Carries only the AppImage, for "--target artifact -o type=local,dest=./out"
FROM scratch AS artifact
COPY --from=builder /out/ /
