# Builds the deb package for one debian-family release.
#
#   podman build -f packaging/Dockerfile.deb -t latte-dock:deb .
#   podman build -f packaging/Dockerfile.deb --target artifact -o type=local,dest=./out .
#
# docker understands the same file. The context is the repository root, so both commands are
# run from there.
#
# One file, one release at a time. Which release is decided by the build arguments, and
# ../build.sh keeps the table of them; the defaults below are the ubuntu 26.04 target.
#
#   BASE_IMAGE       the image to build in, e.g. docker.io/library/ubuntu:26.04
#   NEON_SUITE       empty for a stock ubuntu, or the KDE neon suite to add on top of it,
#                    e.g. "noble". Ubuntu 24.04 carries plasma 5.27 and no KF6 plasma
#                    libraries at all, so Latte 6 does not build on it; neon is the same
#                    24.04 with KDE's own plasma 6 archive over it, and that does.
#   PACKAGE_RELEASE  what goes into the version and the file name, e.g. ubuntu26.04
#   DEPS             which dependency list under packaging/deps to install, ubuntu or neon
#
# The result is a latte-dock_<version>-<release>_amd64.deb, installable with
# "apt install ./latte-dock_<version>-<release>_amd64.deb".
#
# There is one deb per release because a deb can not be anything else. dpkg-shlibdeps reads
# the libraries Latte links out of the packages of the build machine and writes their versions
# into the dependencies, and Latte includes qtx11extras_p.h, so one of the dependencies it
# writes is qt6-base-private-abi, pinned to the exact Qt of that release. A package built on
# one release is refused by apt on every other one, in both directions.

ARG BASE_IMAGE=docker.io/library/ubuntu:26.04

FROM --platform=linux/amd64 ${BASE_IMAGE} AS builder

ARG BUILD_TYPE=Release
ARG JOBS=
ARG NEON_SUITE=
ARG PACKAGE_RELEASE=ubuntu26.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# KDE neon is an ubuntu LTS with KDE's archive over it, so it is that archive rather than a
# base image of its own; the official neon image is the same thing and two gigabytes.
RUN apt-get update \
 && apt-get install --no-install-recommends -y ca-certificates curl \
 && if [ -n "${NEON_SUITE}" ]; then \
        install -d /etc/apt/keyrings \
     && curl -fsSL https://archive.neon.kde.org/public.key -o /etc/apt/keyrings/neon.asc \
     && echo "deb [signed-by=/etc/apt/keyrings/neon.asc] http://archive.neon.kde.org/user ${NEON_SUITE} main" \
            > /etc/apt/sources.list.d/neon.list \
     && apt-get update ; \
    fi

# The dependency list lives next to this file, one per family of package names; neon keeps the
# upstream names where ubuntu renames them. Copied on its own and before the sources, so a
# change to the sources does not reinstall the toolchain.
COPY packaging/deps /deps

ARG DEPS=ubuntu

RUN grep -v '^#' "/deps/${DEPS}.build" | xargs apt-get install --no-install-recommends -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . /src

# The prefix is the one of the distribution, the package installs where the rest of plasma
# lives. LATTE_PACKAGE_RUNTIME_DEPENDS names the packages carrying the qml modules the
# shipped files import, which nothing links against so dpkg-shlibdeps can not find them.
# LATTE_PACKAGE_RELEASE puts the release into the version and through it into the file name,
# so the packages of two releases can be told apart wherever they end up together.
RUN cmake -S /src -B /src/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SUPPRESS_REGENERATION=ON \
        -DBUILD_TESTING=ON \
        -DLATTE_PACKAGE_RELEASE="${PACKAGE_RELEASE}" \
        -DLATTE_PACKAGE_RUNTIME_DEPENDS="$(cat /deps/${DEPS}.runtime)"

RUN cmake --build /src/build ${JOBS:+--parallel ${JOBS}}

# Installing before testing on purpose, the appstream test validates the metadata that was
# installed and the qml test compiles the shipped files against the installed qml modules
RUN cmake --install /src/build

ENV QT_QPA_PLATFORM=offscreen \
    HOME=/tmp/latte-build-home
RUN mkdir -p "${HOME}" \
 && dbus-run-session -- ctest --test-dir /src/build --output-on-failure

RUN cd /src/build \
 && cpack -G DEB \
 && mkdir -p /out \
 && cp /src/build/*.deb /out/ \
 && dpkg-deb --info /out/*.deb \
 && ls -lh /out

# Installing it as well, so a package that can not be installed fails here rather than on the
# machine of whoever downloads it. The already installed tree is removed first, otherwise
# dpkg reports the very same files as belonging to nothing.
#
# The two checks at the end are what keep this image honest about the release it built for:
# the version has to carry it, and the dependencies have to name the Qt they resolved against.
# How tightly that binds depends on the distribution: ubuntu splits out qt6-base-private-abi
# and dpkg-shlibdeps pins it to the exact version, neon ships qt6-base whole and gets a
# ">=" instead. Either way it is the Qt of the machine that built the package.
RUN xargs rm -f < /src/build/install_manifest.txt \
 && apt-get update \
 && apt-get install --no-install-recommends -y /out/*.deb \
 && dpkg -s latte-dock | head -12 \
 && dpkg -s latte-dock | grep -q "^Version: .*-${PACKAGE_RELEASE}$" \
 && dpkg -s latte-dock | tr ',' '\n' | grep -E "qt6-base" \
 && rm -rf /var/lib/apt/lists/*

# Carries only the package, for "--target artifact -o type=local,dest=./out"
FROM scratch AS artifact
COPY --from=builder /out/ /
