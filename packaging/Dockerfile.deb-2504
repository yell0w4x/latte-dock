# Builds the deb package for ubuntu 25.04, the release kubuntu 25.04 is.
#
#   podman build -f packaging/Dockerfile.deb-2504 -t latte-dock:deb-2504 .
#   podman build -f packaging/Dockerfile.deb-2504 --target artifact -o type=local,dest=./out .
#
# docker understands the same file. The context is the repository root, so both commands are
# run from there.
#
# The result is a latte-dock_<version>-ubuntu25.04_amd64.deb, installable with
# "apt install ./latte-dock_<version>-ubuntu25.04_amd64.deb".
#
# There is a file of its own for this release rather than a build argument on Dockerfile.deb
# because a deb is bound to the release it was built on and can not be built for another one.
# dpkg-shlibdeps reads the libraries Latte links out of the packages of the build machine and
# writes their versions into the dependencies, and Latte includes qtx11extras_p.h, so one of
# the dependencies it writes is qt6-base-private-abi, which is pinned to the exact Qt of that
# release. The deb built on 25.10 asks for "qt6-base-private-abi (= 6.9.2)" and 25.04 carries
# Qt 6.8.3 and no such package at all, so apt refuses it. The other direction fails the same
# way. A release that is to have a deb needs an image that builds on it.
#
# 25.04 carries Qt 6.8.3, KDE frameworks 6.12 and plasma 6.3.4, above the floors CMakeLists.txt
# asks for. What it does not carry is a compiled task manager applet plugin, which plasma
# publishes only since 6.5; Latte Tasks is unavailable on this release however Latte is
# installed on it.

ARG BASE_IMAGE=docker.io/library/ubuntu:25.04

FROM --platform=linux/amd64 ${BASE_IMAGE} AS builder

ARG BUILD_TYPE=Release
ARG JOBS=

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# Toolchain, the dependencies CMakeLists.txt declares, and the packages the deb generator
# itself needs, dpkg-dev for dpkg-shlibdeps and file for the type detection it does. The
# plasma runtime packages at the end are not needed to compile, they carry the qml modules
# the shipped files import, which the qml test resolves while it compiles them.
RUN apt-get update \
 && apt-get install --no-install-recommends -y \
        build-essential \
        g++ \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        dpkg-dev \
        file \
        dbus \
        appstream \
        extra-cmake-modules \
        googletest \
        libgtest-dev \
        libgmock-dev \
        qt6-base-dev \
        qt6-base-private-dev \
        qt6-declarative-dev \
        qt6-declarative-private-dev \
        qt6-tools-dev \
        qt6-wayland-dev \
        libkf6archive-dev \
        libkf6coreaddons-dev \
        libkf6crash-dev \
        libkf6dbusaddons-dev \
        libkf6declarative-dev \
        libkf6globalaccel-dev \
        libkf6guiaddons-dev \
        libkf6i18n-dev \
        libkf6iconthemes-dev \
        libkf6kio-dev \
        libkirigami-dev \
        libkf6newstuff-dev \
        libkf6notifications-dev \
        libkf6package-dev \
        libkf6svg-dev \
        libkf6windowsystem-dev \
        libkf6xmlgui-dev \
        libkf6config-dev \
        libplasma-dev \
        libplasmaactivities-dev \
        plasma-workspace-dev \
        kwayland-dev \
        plasma-wayland-protocols \
        libwayland-dev \
        plasma-workspace \
        plasma-desktoptheme \
        qml6-module-org-kde-kirigami \
        qml6-module-org-kde-ksvg \
        qml6-module-org-kde-activities \
        qml6-module-org-kde-kwindowsystem \
        qml6-module-org-kde-pipewire \
        qml6-module-org-kde-plasma-plasma5support \
        libx11-dev \
        libsm-dev \
        libice-dev \
        libxcb1-dev \
        libxcb-util-dev \
        libxcb-shape0-dev \
        libxcb-randr0-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . /src

# The prefix is the one of the distribution, the package installs where the rest of plasma
# lives. LATTE_PACKAGE_RUNTIME_DEPENDS names the packages carrying the qml modules the
# shipped files import, which nothing links against so dpkg-shlibdeps can not find them.
# LATTE_PACKAGE_RELEASE puts the release into the version and through it into the file name,
# so this package and the one built on 25.10 can be told apart wherever they end up together.
RUN cmake -S /src -B /src/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SUPPRESS_REGENERATION=ON \
        -DBUILD_TESTING=ON \
        -DLATTE_PACKAGE_RELEASE=ubuntu25.04 \
        -DLATTE_PACKAGE_RUNTIME_DEPENDS="plasma-workspace, plasma-desktoptheme, qml6-module-org-kde-kirigami, qml6-module-org-kde-ksvg, qml6-module-org-kde-activities, qml6-module-org-kde-kwindowsystem, qml6-module-org-kde-pipewire, qml6-module-org-kde-plasma-plasma5support"

RUN cmake --build /src/build ${JOBS:+--parallel ${JOBS}}

# Installing before testing on purpose, the appstream test validates the metadata that was
# installed and the qml test compiles the shipped files against the installed qml modules
RUN cmake --install /src/build

ENV QT_QPA_PLATFORM=offscreen \
    HOME=/tmp/latte-build-home
RUN mkdir -p "${HOME}" \
 && dbus-run-session -- ctest --test-dir /src/build --output-on-failure

RUN cd /src/build \
 && cpack -G DEB \
 && mkdir -p /out \
 && cp /src/build/*.deb /out/ \
 && dpkg-deb --info /out/*.deb \
 && ls -lh /out

# Installing it as well, so a package that can not be installed fails here rather than on the
# machine of whoever downloads it. The already installed tree is removed first, otherwise
# dpkg reports the very same files as belonging to nothing.
#
# The dependency check at the end is what keeps this image honest about the release it is for:
# the private Qt ABI this build resolved against has to be the one of 25.04, and a package
# that asks for anything newer would install here but not on the machine it is meant for.
RUN xargs rm -f < /src/build/install_manifest.txt \
 && apt-get update \
 && apt-get install --no-install-recommends -y /out/*.deb \
 && dpkg -s latte-dock | head -12 \
 && dpkg -s latte-dock | grep -q "^Version: .*-ubuntu25.04$" \
 && dpkg -s latte-dock | tr ',' '\n' | grep "qt6-base-private-abi" \
 && rm -rf /var/lib/apt/lists/*

# Carries only the package, for "--target artifact -o type=local,dest=./out"
FROM scratch AS artifact
COPY --from=builder /out/ /
