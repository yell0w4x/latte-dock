# Builds the AppImage.
#
#   podman build -f packaging/Dockerfile.appimage -t latte-dock:appimage .
#   podman build -f packaging/Dockerfile.appimage --target artifact -o type=local,dest=./out .
#
# docker understands the same file. The context is the repository root, so both commands are
# run from there.
#
# The result is a single executable Latte_Dock-<version>-<variant>-x86_64.AppImage carrying
# Latte with the Qt, KDE frameworks and plasma libraries it links, the qml modules its shipped
# qml imports and the plasma plugins and package files it reads.
#
# Unlike the deb, an AppImage is not bound to the release it was built on, it is bound to that
# release's glibc, the one library it can not carry: every bundled library resolves against
# the glibc of the host, and the host has to be at least as new. So there is one of these, not
# one per distribution, and the base to build it on is the oldest one that still has what the
# bundle has to hold.
#
# That base is ubuntu 24.04 with the KDE neon archive over it:
#
#   glibc 2.39   older than any other base that can build Latte 6, so the AppImage starts on
#                hosts that refuse everything built on 25.04, 25.10, 26.04 or arch
#   plasma 6.7   which is what carries the compiled task manager applet plugin, published only
#                since plasma 6.5, and that plugin is what Latte Tasks is built on
#
# Stock ubuntu 24.04 is on plasma 5.27 with no KF6 plasma libraries and does not build Latte 6
# at all; every other base is either too new in its glibc or too old in its plasma. This one
# is both old enough to run widely and new enough to carry the tasks.
#
# What it can not carry is the session it docks into: Latte talks to kwin, plasmashell and the
# activity manager of the machine it runs on, so a Plasma 6 session still has to be there.
#
#   BASE_IMAGE   the image to build in
#   NEON_SUITE   empty for a stock ubuntu, or the KDE neon suite to add on top of it
#   DEPS         which dependency list under packaging/deps to install, ubuntu or neon
#   VARIANT      what goes into the file name, e.g. neon24.04
#   GLIBC_FLOOR  the newest glibc symbol the bundle is allowed to ask for, checked at the end
#   QT_PLATFORM_PLUGINS, QT_EXTRA_PLUGINS   the qt plugins to bundle beyond what linuxdeploy
#                finds on its own, named the way the distribution names them

ARG BASE_IMAGE=docker.io/library/ubuntu:24.04

FROM --platform=linux/amd64 ${BASE_IMAGE} AS builder

ARG BUILD_TYPE=Release
ARG JOBS=
ARG NEON_SUITE=noble
ARG VARIANT=neon24.04
ARG GLIBC_FLOOR=2.39

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

# KDE neon is an ubuntu LTS with KDE's archive over it, so it is that archive rather than a
# base image of its own; the official neon image is the same thing and two gigabytes.
RUN apt-get update \
 && apt-get install --no-install-recommends -y ca-certificates curl \
 && if [ -n "${NEON_SUITE}" ]; then \
        install -d /etc/apt/keyrings \
     && curl -fsSL https://archive.neon.kde.org/public.key -o /etc/apt/keyrings/neon.asc \
     && echo "deb [signed-by=/etc/apt/keyrings/neon.asc] http://archive.neon.kde.org/user ${NEON_SUITE} main" \
            > /etc/apt/sources.list.d/neon.list \
     && apt-get update ; \
    fi

# The dependency list lives next to this file, one per family of package names; neon keeps the
# upstream names where ubuntu renames them. Copied on its own and before the sources, so a
# change to the sources does not reinstall the toolchain.
COPY packaging/deps /deps

ARG DEPS=neon

RUN grep -v '^#' "/deps/${DEPS}.build" | xargs apt-get install --no-install-recommends -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . /src

RUN cmake -S /src -B /src/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SUPPRESS_REGENERATION=ON \
        -DBUILD_TESTING=ON

RUN cmake --build /src/build ${JOBS:+--parallel ${JOBS}}

# Installing into the system as well as into the AppDir: the tests below compile the shipped
# qml against the installed modules and validate the installed metadata, the qml modules of
# Latte are picked up from the system by the qt plugin of linuxdeploy, and the AppDir is what
# the AppImage is made of.
RUN cmake --install /src/build \
 && DESTDIR=/AppDir cmake --install /src/build

ENV QT_QPA_PLATFORM=offscreen \
    HOME=/tmp/latte-build-home
RUN mkdir -p "${HOME}" \
 && dbus-run-session -- ctest --test-dir /src/build --output-on-failure

# The plugins, qml modules and package files Latte reaches for at runtime. Nothing links
# against these, so no tool can find them by walking the libraries, and the dock comes up
# empty without them.
#
# The plugins go where usr/bin/qt.conf points Qt at, "usr/plugins", and not into the qt
# directory they are installed in; the second one is searched by nothing inside an AppImage.
# kpackage carries the structures that make a plasma package readable at all, plasma the
# applets, among them the task manager applet Latte Tasks is built on.
RUN set -eu \
 && qtdir="/usr/lib/x86_64-linux-gnu/qt6" \
 && mkdir -p "/AppDir/usr/plugins" "/AppDir/usr/qml" "/AppDir/usr/share" \
 && for plugins in plasma kpackage kf6 kcms styles platformthemes ; do \
        if [ -d "${qtdir}/plugins/${plugins}" ]; then \
            cp -a "${qtdir}/plugins/${plugins}" "/AppDir/usr/plugins/" ; \
        fi ; \
    done \
 && for module in \
        org/kde/latte \
        org/kde/plasma \
        org/kde/kirigami \
        org/kde/ksvg \
        org/kde/taskmanager \
        org/kde/pipewire \
        org/kde/activities \
        org/kde/kwindowsystem \
        org/kde/kquickcontrolsaddons \
        org/kde/config \
        org/kde/kcmutils \
        org/kde/kitemmodels \
        org/kde/coreaddons \
        org/kde/draganddrop \
        org/kde/notification \
        Qt5Compat/GraphicalEffects ; do \
        if [ -d "${qtdir}/qml/${module}" ]; then \
            mkdir -p "/AppDir/usr/qml/$(dirname ${module})" ; \
            cp -a "${qtdir}/qml/${module}" "/AppDir/usr/qml/$(dirname ${module})/" ; \
        fi ; \
    done \
 && for data in plasma kservicetypes6 kf6 knotifications6 ; do \
        if [ -d "/usr/share/${data}" ]; then \
            cp -a "/usr/share/${data}" "/AppDir/usr/share/" ; \
        fi ; \
    done \
 && test -d "/AppDir/usr/plugins/kpackage/packagestructure" \
 && test -d "/AppDir/usr/share/plasma/plasmoids/org.kde.latte.containment" \
 && test -f "/AppDir/usr/plugins/plasma/applets/org.kde.plasma.taskmanager.so"

# linuxdeploy walks the binary and everything it loads and pulls the libraries in; its qt
# plugin does the same for the qt plugins and the qml modules named below. Both are AppImages
# themselves, and the extract and run mode is what lets them run in a container, which has no
# fuse.
#! NO_APPSTREAM keeps appimagetool from validating the metadata a second time. It refuses
#! any warning at all, and the one it finds is cid-rdns-contains-hyphen: the component id of
#! Latte is org.kde.latte-dock.desktop and the hyphen in it is how Latte is published. The
#! test suite validates that same metadata a few steps above and accepts only that warning,
#! see cmake/LatteAppstreamTest.cmake.
#! The qt plugin deploys the xcb platform on its own. Latte also runs on wayland sessions,
#! and the offscreen one is what lets the checks at the end start the bundled binary without
#! a display of any kind.
#! The names of the wayland platform plugin and of the plugin directories next to it are the
#! distribution's, not Qt's: neon carries the upstream ones, libqwayland.so and the wayland-*
#! directories, where debian and ubuntu rename and split them. They are arguments for that
#! reason, with neon's as the default.
ARG QT_PLATFORM_PLUGINS="libqwayland.so;libqoffscreen.so;libqminimal.so"
ARG QT_EXTRA_PLUGINS="wayland-shell-integration;wayland-decoration-client;wayland-graphics-integration-client"

ENV APPIMAGE_EXTRACT_AND_RUN=1 \
    NO_APPSTREAM=1 \
    DISABLE_COPYRIGHT_FILES_DEPLOYMENT=1 \
    QMAKE=/usr/lib/qt6/bin/qmake6 \
    EXTRA_PLATFORM_PLUGINS="${QT_PLATFORM_PLUGINS}" \
    EXTRA_PLUGINS="${QT_EXTRA_PLUGINS}" \
    QML_SOURCES_PATHS=/src

RUN set -eu \
 && cd /tmp \
 && wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
 && wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
 && chmod +x linuxdeploy-x86_64.AppImage linuxdeploy-plugin-qt-x86_64.AppImage

# The desktop file Latte installs starts the binary by its full path, which inside an
# AppImage points at whatever the host has rather than at what is bundled. The copy in the
# AppDir names it plainly, so the one next to it is the one that runs.
RUN sed -i 's|^Exec=.*|Exec=latte-dock|' \
        /AppDir/usr/share/applications/org.kde.latte-dock.desktop

# The version reaches the file name of the AppImage through this, the way linuxdeploy expects
# it to be given, and the name says which base it was built on.
#! --deploy-deps-only names the directories that were filled in above: the libraries those
#! plugins and qml plugins need are pulled in and their rpath is rewritten to the bundled
#! ones, which is what linuxdeploy does on its own only for what it copied itself.
#! --custom-apprun replaces the symlink linuxdeploy would leave behind with the script that
#! points XDG_DATA_DIRS at the plasma package files of the bundle, see packaging/AppRun.
ARG VARIANT
RUN set -eu \
 && export VERSION="$(sed -n 's/^set(VERSION *\([^)]*\))/\1/p' /src/CMakeLists.txt | head -1)" \
 && mkdir -p /out \
 && cd /out \
 && /tmp/linuxdeploy-x86_64.AppImage \
        --appdir /AppDir \
        --executable /AppDir/usr/bin/latte-dock \
        --custom-apprun=/src/packaging/AppRun \
        --deploy-deps-only=/AppDir/usr/plugins \
        --deploy-deps-only=/AppDir/usr/qml \
        --plugin qt \
        --desktop-file /AppDir/usr/share/applications/org.kde.latte-dock.desktop \
        --icon-file /AppDir/usr/share/icons/hicolor/scalable/apps/latte-dock.svg \
        --output appimage \
 && mv /out/Latte_Dock-"${VERSION}"-x86_64.AppImage "/out/Latte_Dock-${VERSION}-${VARIANT}-x86_64.AppImage" \
 && chmod +x /out/*.AppImage \
 && ls -lh /out

# Unpacking it again and starting what it carries, so an AppImage that can not run at all
# fails the build here.
#
# It starts twice: once for its version, and once with a home of its own, where it imports the
# default layout, and what it says about that is read back: whether the corona found its shell
# package and every package the layout names, which is what the AppRun and the plugins above
# are there for and what breaks silently when either of them is wrong, and whether the tasks
# plasmoid found the applet plugin it is built on. Latte has no session to dock into here, so
# it is left running for a while and then stopped.
RUN set -eu \
 && cd /tmp \
 && /out/*.AppImage --appimage-extract > /dev/null \
 && ./squashfs-root/AppRun --version \
 && grep -q XDG_DATA_DIRS ./squashfs-root/AppRun \
 && export HOME=/tmp/latte-appimage-home \
 && mkdir -p "${HOME}" \
 && dbus-run-session -- timeout 40 ./squashfs-root/AppRun --debug > /tmp/appimage-check.log 2>&1 || true \
 && ! grep -q "Failed to load fallback plasma shell package" /tmp/appimage-check.log \
 && ! grep -q "the package QJsonObject() is invalid" /tmp/appimage-check.log \
 && ! grep -q "does not exist" /tmp/appimage-check.log \
 && grep -q "Task manager applet qml types registered" /tmp/appimage-check.log \
 && ! grep -q "Latte Tasks will not be available" /tmp/appimage-check.log

# The glibc floor of the bundle, which is the one thing that decides which hosts this AppImage
# starts on. Every bundled library is asked which glibc symbols it wants and the newest answer
# has to be one the base itself has, otherwise the AppImage is quietly narrower than the base
# it was built on promises. This is not hypothetical: an earlier bundle built on 25.10 pulled
# in a libssh that wanted GLIBC_2.42 through libavformat and libKPipeWireRecord, and that one
# library alone kept its pipewire module from loading on anything older.
ARG GLIBC_FLOOR
RUN set -eu \
 && cd /tmp \
 && floor="$(find ./squashfs-root/usr -type f \( -name '*.so*' -o -name 'latte-dock' \) \
                -exec objdump -T {} + 2> /dev/null \
             | grep -o 'GLIBC_2\.[0-9]*' | sort -u -V | tail -1)" \
 && echo "the bundle asks for at most ${floor}, the base allows GLIBC_${GLIBC_FLOOR}" \
 && [ "$(printf '%s\nGLIBC_%s\n' "${floor}" "${GLIBC_FLOOR}" | sort -V | tail -1)" = "GLIBC_${GLIBC_FLOOR}" ] \
 && rm -rf /tmp/squashfs-root

# Carries only the AppImage, for "--target artifact -o type=local,dest=./out"
FROM scratch AS artifact
COPY --from=builder /out/ /
